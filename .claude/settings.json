{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(py -m venv:*)",
      "Bash(python -c:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(printf:*)",
      "Bash(ipconfig:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
