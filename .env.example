# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.

# Google AI Studio'dan ücretsiz anahtar: https://aistudio.google.com/apikey
# Boş bırakılırsa sistem yalnızca tam metin arama + alıntı cevap ile çalışır.
GEMINI_API_KEY=

# Modeller (değiştirmeniz gerekmez)
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# JWT imza anahtarı — en az 32 karakterlik rastgele bir metin girin
JWT_SECRET=degistir-beni-en-az-32-karakter-rastgele-metin

# Yönetim paneli (http://localhost:8000/admin) için ilk admin hesabı
ADMIN_EMAIL=admin@aerostd.dev
ADMIN_PASSWORD=Admin12345!

# Veritabanı boşsa kamuya açık standartları otomatik indir
AUTO_SEED=true

# Docker dışında (yerel Python ile) çalıştırırken:
# DATABASE_URL=postgresql://aerostd:aerostd@localhost:5432/aerostd
