# Aerospace Compliance Platform - Mobil API ayarları
# Bu dosyayı ".env" adıyla kopyalayıp değiştirebilirsiniz. .env olmadan da uygulama varsayılanlarla çalışır.

# Uygulama adı (Swagger başlığında ve GET / cevabında görünür)
APP_NAME=Aerospace Compliance Platform
# Uygulama sürümü
APP_VERSION=1.1.0
# Sürümlü API yollarının ön eki
API_V1_PREFIX=/api/v1

# false: kimlik doğrulama kapalı, her istek demo kullanıcıyla çalışır (Taha JWT'yi bağlayınca true olacak)
AUTH_ENABLED=false

# Arama sağlayıcısı: mock (şimdilik). Sudenur'un hibrit araması bağlanınca değişecek
SEARCH_PROVIDER=mock
# LLM sağlayıcısı: mock (şimdilik) veya ileride gemini
LLM_PROVIDER=mock
# Gemini API anahtarı (gizli; asla commit edilmez). Mock modda boş kalır
GEMINI_API_KEY=
# Kullanılacak Gemini modeli
GEMINI_MODEL=gemini-2.5-flash

# Yüklenebilecek en büyük PDF boyutu (MB). (top_k <= 20 ve page_size <= 100 sınırları kodda sabittir)
MAX_UPLOAD_MB=50
# Yüklenen dosyaların yazılacağı klasör
STORAGE_DIR=./storage

# İzin verilen CORS kaynakları (JSON liste). Geliştirmede hepsi açık
CORS_ORIGINS=["*"]

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
